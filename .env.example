# Optional. Only needed for email. Copy to .env and fill in.
# .env is gitignored. Never commit it or paste these values anywhere.

# Gmail: turn on 2-step verification, then create an app password at
# myaccount.google.com/apppasswords. Other providers: change the host/port.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Where the digest goes. One address.
EMAIL_TO=

# Optional. Only needed for LinkedIn. Your Apify API token, from
# console.apify.com/settings/integrations. Then set linkedin: true in
# config.yaml.
APIFY_TOKEN=
